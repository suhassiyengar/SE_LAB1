<mxfile host="app.diagrams.net">
  <diagram name="Use-Case Diagram" id="uc1">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="Campus Placement &amp; Internship Pipeline System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="40" width="680" height="560" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="actorStudent" value="Student Applicant" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalLabelPosition=bottom;labelPosition=center;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="40" height="80" as="geometry" />
        </mxCell>

        <mxCell id="actorPO" value="Placement Officer" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalLabelPosition=bottom;labelPosition=center;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Use cases: Student-facing -->
        <mxCell id="uc1" value="Register &amp; Login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc2" value="Upload Resume" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc3" value="Apply to Placement Drive" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="250" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc4" value="Track Application Status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc5" value="Attend Interview" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="430" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Use cases: shared / helper -->
        <mxCell id="uc6" value="Parse Resume &amp; Extract Skills" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc7" value="Screen Applicants &amp; Apply Eligibility Filters" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc8" value="Flag Ineligibility Reason" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="340" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Use cases: Placement Officer-facing -->
        <mxCell id="uc9" value="Define Eligibility Criteria" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
