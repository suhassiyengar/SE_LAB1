        <mxCell id="uc11" value="Generate Offer Letter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc12" value="View Placement Analytics" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="180" height="60" as="geometry" />
